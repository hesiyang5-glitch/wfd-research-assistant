# WFD Coding Assistant — server-side configuration.
# Copy this file to ".env" (same folder) and fill in what you have. Keys stay on your computer;
# they are never sent to the browser, written to logs, or included in exports.
# Restart the app after editing.

# ---- Web search (needed for AUTOMATIC source discovery; configure at least one) ----
# Tavily: https://tavily.com  (sign up → API key)
TAVILY_API_KEY=
# Brave Search API: https://brave.com/search/api/  (subscription token)
BRAVE_API_KEY=
# Self-hosted SearXNG (free): URL of your instance with JSON output enabled, e.g. http://localhost:8888
SEARXNG_URL=

# ---- Language model (needed for automatic coding suggestions) ----
# Anthropic Claude: https://console.anthropic.com  → API keys
ANTHROPIC_API_KEY=
# Or any OpenAI-compatible endpoint (OpenAI, or a LOCAL model via Ollama/LM Studio):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b

# ---- Optional: neural embeddings for semantic retrieval (otherwise LSA is used) ----
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434/v1

# ---- Login (required when the app is reachable from other computers) ----
# WFD_PASSWORD=choose-a-long-team-password

# ---- Optional server settings ----
# WFD_PORT=8765
# WFD_HOST=127.0.0.1        # 0.0.0.0 makes it reachable from other computers; then WFD_PASSWORD is required
# WFD_DATA_DIR=./data
